@'
# Secrets and local configuration
.env
.env.*
!.env.example

# Python environment and cache
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local database and logs
security.db
security.db-*
*.log

# Node dependencies and build artifacts
node_modules/
frontend/node_modules/
frontend/dist/

# IDE and Git
.idea/
.git/

# Local test request files
mcp-call.json
mcp-init.json
mcp-products.json
mcp-tools.json
member-call.json
member-denied-test.json
'@ | Set-Content -Path .dockerignore -Encoding utf8